// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DELIVERYMAN
  CLIENT
}

enum AddressType {
  BILLING
  SHIPPING
}

// ACCOUNT
model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  roles       Role[]       @default([CLIENT])
  permissions String[]
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  addresses   Address[]
  deliveryman Deliveryman?
  deliveries  Delivery[]

  @@map("users")
}

model Token {
  id            String   @id @default(uuid())
  user_id       String   @unique
  refresh_token String
  expires_at    DateTime

  @@map("tokens")
}

model Address {
  id           String      @id @default(uuid())
  user_id      String
  user         User        @relation(fields: [user_id], references: [id])
  type         AddressType @default(SHIPPING)
  full_name    String
  phone        String
  postal_code  String
  country      String
  state        String
  city         String
  neighborhood String
  street       String
  number       String
  complement   String
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@map("addresses")
}

model Deliveryman {
  id           String     @id @default(uuid())
  user_id      String     @unique
  user         User       @relation(fields: [user_id], references: [id])
  profile_name String
  available    Boolean
  deliveries   Delivery[]
  created_at   DateTime   @default(now())

  @@map("deliverymen")
}

model Delivery {
  id             String      @id @default(uuid())
  client_id      String
  client         User        @relation(fields: [client_id], references: [id])
  deliveryman_id String
  deliveryman    Deliveryman @relation(fields: [deliveryman_id], references: [id])
  title          String
  description    String
  delivered_at   DateTime
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@map("deliveries")
}
